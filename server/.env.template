# =============================================================================
# RSU MANAGER - PLANTILLA DE VARIABLES DE ENTORNO DEL SERVIDOR (BACKEND)
# Copia este archivo a `server/.env` y completa los valores correspondientes.
# Ninguna de estas credenciales se expone al DOM ni al navegador.
# =============================================================================

# --- Servidor HTTP y CORS ---
# Puerto donde se ejecuta el backend en desarrollo local (Ej: 4000)
PORT=4000
# Entorno de ejecución (development | production)
NODE_ENV=development
# URL del cliente React (Vite) permitida por CORS para envío de cookies HttpOnly
CLIENT_URL=http://localhost:5173
# URL pública del backend (utilizada para callbacks de OAuth)
SERVER_PUBLIC_URL=http://localhost:4000

# --- Conexión a Base de Datos PostgreSQL (Supabase) ---
# Cadena de conexión PostgreSQL provista por Supabase (Session Pooler IPv4 recomendado)
# Ejemplo: postgresql://rsu_backend.ntsuudwvxzxxxjfejzyn:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://rsu_backend.ntsuudwvxzxxxjfejzyn:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Control de verificación de certificado SSL para conexión PostgreSQL
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --- Credenciales de Supabase Auth (Exclusivas del Backend) ---
# URL del proyecto de Supabase (Ej: https://tu-proyecto.supabase.co)
SUPABASE_URL=https://ntsuudwvxzxxxjfejzyn.supabase.co
# Clave publicable/anon de Supabase (Ej: sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE_PUBLICABLE
# Clave secreta administrativa de Supabase (Ej: sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_TU_CLAVE_SECRETA
# Endpoint JWKS de verificación de firmas de tokens de Supabase
SUPABASE_JWKS_URL=https://ntsuudwvxzxxxjfejzyn.supabase.co/auth/v1/.well-known/jwks.json

# --- Seguridad de Sesión (Cookies HttpOnly contra suplantación de roles) ---
# Nombre de la cookie HttpOnly que almacena el identificador de sesión firmado
SESSION_COOKIE_NAME=rsu_session
# Secreto criptográfico aleatorio de al menos 32 caracteres para firmar la cookie HttpOnly
SESSION_JWT_SECRET=reemplazar_por_secreto_largo_y_seguro_en_produccion
# Tiempo de expiración de la sesión en milisegundos (Ej: 604800000 = 7 días)
SESSION_MAX_AGE_MS=604800000

# --- Parámetros de Negocio y Multi-Inquilino (Multi-Tenant) ---
# Código del inquilino principal por defecto
DEFAULT_TENANT_CODE=RSU
# Nombre comercial del inquilino por defecto
DEFAULT_TENANT_NAME=RSU Gestión Ambiental
# Radio máximo en metros permitido para validar geolocalización del recolector en un punto
GEOFENCE_RADIUS_METERS=250
# Tarifa base por movimiento de volquete (en moneda local)
DEFAULT_VOLQUETE_TARIFA=45000

# --- Servicios Externos de Ruteo y Geocodificación ---
# Servidor OSRM para cálculo de rutas óptimas por calles
OSRM_BASE_URL=https://router.project-osrm.org
# Servidor Nominatim OpenStreetMap para búsqueda de direcciones
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- Notificaciones Push (Web Push VAPID) ---
# Correo o URL de contacto para el protocolo VAPID
VAPID_SUBJECT=mailto:notificaciones@rsu-ambiental.com.ar
# Clave pública VAPID (generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=TU_VAPID_PUBLIC_KEY
# Clave privada VAPID (generar con: npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=TU_VAPID_PRIVATE_KEY

