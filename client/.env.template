# =============================================================================
# RSU MANAGER - PLANTILLA DE VARIABLES DE ENTORNO DEL CLIENTE (FRONTEND)
# Copia este archivo a `client/.env`. No coloques credenciales privadas aquí.
# =============================================================================

# Prefijo base de la API REST (por defecto: /api)
VITE_API_BASE_URL=/api

# URL del backend local a la que Vite hace proxy en desarrollo (por defecto: http://localhost:4000)
VITE_DEV_SERVER_PROXY_TARGET=http://localhost:4000

# Nombre comercial visible en la interfaz de usuario
VITE_APP_NAME=RSU Manager

# Coordenadas por defecto para centrado inicial de mapas (Ejemplo: -34.6037, -58.3816)
VITE_DEFAULT_MAP_LAT=-34.6037
VITE_DEFAULT_MAP_LNG=-58.3816
VITE_DEFAULT_MAP_ZOOM=13

# Servidor de teselas cartográficas OpenStreetMap
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

